# `supabase secrets set --env-file .env` で Edge Functions に設定する
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# pg_cron からの呼び出しを確認する合言葉（Vault の cron_secret と同じ値。ランダムな長い文字列）
CRON_SECRET=
# メインチャット登録用の合言葉（管理用グループで「#メイン登録 <この値>」と送る）
MAIN_REGISTER_CODE=

# 以下は任意
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# EXTRACT_IDLE_MINUTES=10
# EXTRACT_MIN_PENDING=30
# EXTRACT_MAX_PROJECTS=5
# 案件チャットにボットが参加したときの告知文（未設定なら何も発言しない）
# JOIN_MESSAGE=タスク管理ボットです。この会話からタスクを記録し、管理用チャットに共有します。
